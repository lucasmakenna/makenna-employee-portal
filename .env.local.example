# ─────────────────────────────────────────────────────────────────────
# Email (Resend)
# ─────────────────────────────────────────────────────────────────────
# 1. Sign up at https://resend.com (free tier = 3,000 emails/mo)
# 2. Verify the email address you signed up with — this is your test inbox
# 3. Go to https://resend.com/api-keys and create a new key
# 4. Paste it below as RESEND_API_KEY
# 5. Copy this file to .env.local (drop the .example) so Next picks it up
# 6. Restart the dev server (Ctrl+C then `npm run dev`)
#
# In test mode (no domain verified), Resend only delivers to the email
# you signed up with. Set TEST_RECIPIENT_EMAIL to that address and every
# email the app sends will be redirected there with a "[TEST MODE]" banner
# noting the original recipient.
#
# When you've verified makennakoffee.com, change EMAIL_FROM to
# 'Makenna Koffee <hello@makennakoffee.com>' and remove
# TEST_RECIPIENT_EMAIL — emails will then go to the real recipients.

RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM='Makenna Koffee <onboarding@resend.dev>'
TEST_RECIPIENT_EMAIL=lucas@makennakoffee.com

# ─────────────────────────────────────────────────────────────────────
# Square (POS / Team / Labor / Catalog)
# ─────────────────────────────────────────────────────────────────────
# 1. Sign up at https://developer.squareup.com (free, separate from your
#    main Square business account but linked to it).
# 2. Click "+ Application" → name it "Makenna Team Portal" → Create.
# 3. In your new app, you'll see Sandbox and Production tabs:
#       Sandbox = fake test merchant — safe to play with
#       Production = your real Makenna Koffee business
#    Start with Sandbox until everything works, then flip to Production.
# 4. Copy the Sandbox Access Token and Sandbox Application ID below.
# 5. Restart `npm run dev` to pick them up.
# 6. Once running, visit /locations in the portal — there's a "Square
#    connection" panel that will say "Connected" with your real location
#    list, or show the exact error if anything's wrong.

SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=EAAAEY-paste-your-sandbox-token-here
SQUARE_APPLICATION_ID=sandbox-sq0idb-your-app-id-here
